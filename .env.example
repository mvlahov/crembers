# Copy to .env.local for local work; set the same keys in Vercel → Project → Settings → Environment Variables.

# Postgres connection string (Neon / Supabase free tier, or local).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup)
WHATSAPP_TOKEN=            # permanent System User access token
WHATSAPP_PHONE_NUMBER_ID=  # "Phone number ID", not the phone number itself
WHATSAPP_APP_SECRET=       # App settings → Basic → App secret (verifies webhook signatures)
WHATSAPP_VERIFY_TOKEN=     # any string you make up; type the same one in the webhook settings
WHATSAPP_TEMPLATE=crembers_update  # approved template for messages outside the 24h window
# WHATSAPP_API_VERSION=v23.0

# Password for the admin inbox at /admin (long and random).
ADMIN_PASSWORD=

# Optional: your own number (digits only) — gets a note on every new request and acceptance.
ADMIN_PHONE=
